{
  "name": "pm-kanban",
  "productName": "PM-Kanban",
  "version": "1.0.0",
  "description": "PM-Kanban: gestione attività di progetto con Kanban, Gantt, Calendario, Agenda e Dashboard. Dati su cartella SharePoint sincronizzata.",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n VITE,MAIN,APP -c cyan,yellow,green \"vite\" \"tsc -p tsconfig.main.json -w --preserveWatchOutput\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.2",
    "vite": "^8.3.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "@electron/get": "5.1.0",
    "shell-quote": "1.12.0"
  },
  "build": {
    "appId": "it.pmkanban.app",
    "productName": "PM-Kanban",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "resources/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "shortcutName": "PM-Kanban",
      "artifactName": "PM-Kanban-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "PM-Kanban-Portable-${version}.exe"
    }
  },
  "author": "Alessandro Puglisi"
}
