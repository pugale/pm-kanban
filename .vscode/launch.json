{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Avvia PM-Kanban (debug processo principale)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": { "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd" },
      "args": ["."],
      "preLaunchTask": "Compila tutto",
      "outputCapture": "std",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist-electron/**/*.js"]
    }
  ]
}
